  {
   "fieldname": "formula_guide_html",
   "fieldtype": "HTML",
   "label": "Formula Reference Guide",
   "options": "<div style=\"font-family:var(--font-stack,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);font-size:13px;line-height:1.5;padding:4px 0 10px\">\n\n  <!-- How cost is calculated -->\n  <div style=\"background:#e3f2fd;border-left:4px solid #1976d2;padding:10px 14px;border-radius:0 6px 6px 0;margin-bottom:14px\">\n    <div style=\"font-weight:700;color:#1565c0;font-size:13px;margin-bottom:6px\">&#9881;&#65039; How Machine Cost is Calculated</div>\n    <div style=\"font-family:'Courier New',monospace;font-size:12px;color:#0d47a1;line-height:1.9\">\n      <b>Cost = req_qty &times; rate</b><br>\n      <span style=\"color:#666\">&#8212; Default (no formula) &#8212;</span><br>\n      req_qty &nbsp;= <b>total_hrs</b> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:#555\">&larr; overridden by Qty Formula</span><br>\n      rate &nbsp;&nbsp;&nbsp;&nbsp;= <b>machine_cost_per_hour</b> &nbsp;<span style=\"color:#555\">&larr; overridden by Rate Formula</span>\n    </div>\n  </div>\n\n  <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px\">\n\n    <!-- Time Variables -->\n    <div>\n      <div style=\"background:#1565c0;color:#fff;padding:5px 10px;border-radius:5px 5px 0 0;font-weight:700;font-size:11px;letter-spacing:.5px\">&#128336; TIME VARIABLES</div>\n      <table style=\"width:100%;border-collapse:collapse;background:#e3f2fd\">\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#0d47a1;font-size:12px\">total_hrs</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">(Makeready + Production) &times; Cycles</td></tr>\n        <tr style=\"background:#bbdefb\"><td style=\"padding:4px 8px;font-family:monospace;color:#0d47a1;font-size:12px\">makeready_hrs</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Setup / makeready hours</td></tr>\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#0d47a1;font-size:12px\">production_hrs</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">unit_qty &divide; max_output &times; pass_count</td></tr>\n        <tr style=\"background:#bbdefb\"><td style=\"padding:4px 8px;font-family:monospace;color:#0d47a1;font-size:12px\">pass_count</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Printing: ceil(colors/capacity)<br>Non-print: ops sharing machine</td></tr>\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#0d47a1;font-size:12px\">cycles</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Repeat cycles (set per job)</td></tr>\n        <tr style=\"background:#bbdefb\"><td style=\"padding:4px 8px;font-family:monospace;color:#0d47a1;font-size:12px\">unit_qty</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Qty in spec unit (sheets/pcs/sqin)</td></tr>\n      </table>\n    </div>\n\n    <!-- Quantity Variables -->\n    <div>\n      <div style=\"background:#2e7d32;color:#fff;padding:5px 10px;border-radius:5px 5px 0 0;font-weight:700;font-size:11px;letter-spacing:.5px\">&#128230; SHEET &amp; JOB QUANTITIES</div>\n      <table style=\"width:100%;border-collapse:collapse;background:#e8f5e9\">\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#1b5e20;font-size:12px\">item_qty</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Total order quantity (pcs)</td></tr>\n        <tr style=\"background:#c8e6c9\"><td style=\"padding:4px 8px;font-family:monospace;color:#1b5e20;font-size:12px\">full_sheet_qty</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Number of full sheets</td></tr>\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#1b5e20;font-size:12px\">cut_sheet_qty</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Number of cut sheets</td></tr>\n        <tr style=\"background:#c8e6c9\"><td style=\"padding:4px 8px;font-family:monospace;color:#1b5e20;font-size:12px\">cut_sheet_area</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Cut sheet area (L &times; W mm)</td></tr>\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#1b5e20;font-size:12px\">no_of_colors</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Colors in job</td></tr>\n        <tr style=\"background:#c8e6c9\"><td style=\"padding:4px 8px;font-family:monospace;color:#1b5e20;font-size:12px\">no_of_cuts</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Number of cuts</td></tr>\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#1b5e20;font-size:12px\">no_of_ups</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Number of ups per sheet</td></tr>\n        <tr style=\"background:#c8e6c9\"><td style=\"padding:4px 8px;font-family:monospace;color:#1b5e20;font-size:12px\">reel_area / reel_length</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Flexo only</td></tr>\n      </table>\n    </div>\n\n  </div>\n\n  <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px\">\n\n    <!-- Cost Parameters -->\n    <div>\n      <div style=\"background:#e65100;color:#fff;padding:5px 10px;border-radius:5px 5px 0 0;font-weight:700;font-size:11px;letter-spacing:.5px\">&#128181; COST PARAMETERS</div>\n      <table style=\"width:100%;border-collapse:collapse;background:#fff3e0\">\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#bf360c;font-size:12px\">machine_cost_per_hour</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Running cost per hour (LKR) &#8212; default rate</td></tr>\n      </table>\n    </div>\n\n    <!-- Math Functions -->\n    <div>\n      <div style=\"background:#6a1b9a;color:#fff;padding:5px 10px;border-radius:5px 5px 0 0;font-weight:700;font-size:11px;letter-spacing:.5px\">&#128290; MATH FUNCTIONS</div>\n      <table style=\"width:100%;border-collapse:collapse;background:#f3e5f5\">\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#4a148c;font-size:12px\">ceil(x)</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Round up</td></tr>\n        <tr style=\"background:#e1bee7\"><td style=\"padding:4px 8px;font-family:monospace;color:#4a148c;font-size:12px\">floor(x)</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Round down</td></tr>\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#4a148c;font-size:12px\">max(a, b)</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Larger of two values</td></tr>\n        <tr style=\"background:#e1bee7\"><td style=\"padding:4px 8px;font-family:monospace;color:#4a148c;font-size:12px\">min(a, b)</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Smaller of two values</td></tr>\n        <tr><td style=\"padding:4px 8px;font-family:monospace;color:#4a148c;font-size:12px\">round(x, n)</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Round to n decimal places</td></tr>\n        <tr style=\"background:#e1bee7\"><td style=\"padding:4px 8px;font-family:monospace;color:#4a148c;font-size:12px\">abs(x)</td><td style=\"padding:4px 8px;color:#333;font-size:12px\">Absolute value</td></tr>\n      </table>\n    </div>\n\n  </div>\n\n  <!-- Examples -->\n  <div style=\"background:#fafafa;border:1px solid #e0e0e0;border-radius:6px;padding:12px 14px\">\n    <div style=\"font-weight:700;color:#333;margin-bottom:10px;font-size:13px\">&#128203; Formula Examples</div>\n\n    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px\">\n\n      <div style=\"background:#e3f2fd;border-radius:5px;padding:8px 10px\">\n        <div style=\"font-size:11px;font-weight:700;color:#1565c0;margin-bottom:4px\">STANDARD MACHINE HOUR</div>\n        <div style=\"font-family:monospace;font-size:12px;color:#1976d2\">Qty: <i>(leave blank)</i><br>Rate: <i>(leave blank)</i></div>\n        <div style=\"font-size:11px;color:#555;margin-top:4px\">Cost = total_hrs &times; machine_cost_per_hour</div>\n      </div>\n\n      <div style=\"background:#e8f5e9;border-radius:5px;padding:8px 10px\">\n        <div style=\"font-size:11px;font-weight:700;color:#2e7d32;margin-bottom:4px\">CHARGE PER CUT SHEET</div>\n        <div style=\"font-family:monospace;font-size:12px;color:#388e3c\">Qty: cut_sheet_qty<br>Rate: 0.5</div>\n        <div style=\"font-size:11px;color:#555;margin-top:4px\">e.g. 0.50 LKR per cut sheet</div>\n      </div>\n\n      <div style=\"background:#fff3e0;border-radius:5px;padding:8px 10px\">\n        <div style=\"font-size:11px;font-weight:700;color:#e65100;margin-bottom:4px\">MINIMUM HOURS ENFORCED</div>\n        <div style=\"font-family:monospace;font-size:12px;color:#f57c00\">Qty: max(total_hrs, 0.5)<br>Rate: <i>(leave blank)</i></div>\n        <div style=\"font-size:11px;color:#555;margin-top:4px\">Always charge at least 0.5 hrs</div>\n      </div>\n\n      <div style=\"background:#f3e5f5;border-radius:5px;padding:8px 10px\">\n        <div style=\"font-size:11px;font-weight:700;color:#6a1b9a;margin-bottom:4px\">AREA-BASED CHARGE</div>\n        <div style=\"font-family:monospace;font-size:12px;color:#7b1fa2\">Qty: cut_sheet_area * cut_sheet_qty<br>Rate: 0.002</div>\n        <div style=\"font-size:11px;color:#555;margin-top:4px\">e.g. lamination cost per mm&sup2;</div>\n      </div>\n\n      <div style=\"background:#fce4ec;border-radius:5px;padding:8px 10px\">\n        <div style=\"font-size:11px;font-weight:700;color:#880e4f;margin-bottom:4px\">PER-COLOR RATE OVERRIDE</div>\n        <div style=\"font-family:monospace;font-size:12px;color:#c2185b\">Qty: total_hrs<br>Rate: machine_cost_per_hour * no_of_colors</div>\n        <div style=\"font-size:11px;color:#555;margin-top:4px\">Rate scales with number of colors</div>\n      </div>\n\n      <div style=\"background:#e0f2f1;border-radius:5px;padding:8px 10px\">\n        <div style=\"font-size:11px;font-weight:700;color:#004d40;margin-bottom:4px\">MINIMUM COST GUARANTEE</div>\n        <div style=\"font-family:monospace;font-size:12px;color:#00695c\">Qty: max(total_hrs, 1)<br>Rate: max(machine_cost_per_hour, 2500)</div>\n        <div style=\"font-size:11px;color:#555;margin-top:4px\">Floor on both hours and rate</div>\n      </div>\n\n    </div>\n  </div>\n\n</div>"
  },
