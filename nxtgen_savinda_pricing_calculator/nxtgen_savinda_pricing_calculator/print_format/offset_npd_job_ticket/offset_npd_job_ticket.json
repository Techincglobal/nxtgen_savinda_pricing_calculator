 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    .print-format td, .print-format th { padding: 3px !important; }\n    .print-format { margin-left: 5mm; margin-right: 5mm; font-family: Arial, sans-serif; }\n</style>\n\n<head>\n    <meta name=\"pdfkit-margin-top\" content=\"30mm\"/>\n    <meta name=\"pdfkit-orientation\" content=\"Landscape\"/>\n</head>\n\n{% set d = get_npd_print_data(doc.name) %}\n{% set created_by = d.created_by or (frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner) %}\n\n<div id=\"header-html\">\n    <table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n        <tr>\n            <td width=30%></td>\n            <td style=\"width: 40%; text-align: center;\">Savinda Graphic Systems (Pvt) Ltd.<br><b>Offset NPD Job Ticket ( No FSC ) ( NEW )</b></td>\n            <td width=30% style=\"text-align:right;\"><img src=\"https://barcodeapi.org/api/128/{{ doc.name }}\" alt=\"Barcode\" /></td>\n        </tr>\n    </table>\n</div>\n<div id=\"footer-html\" class=\"visible-pdf\">Page <span class=\"page\"></span> of <span class=\"topage\"></span></div>\n\n<table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n    <tr>\n        <td width=50%>Customer : {{ doc.customer_name or \"\" }}</td>\n        <td width=25%>NPD No : {{ doc.name }}</td>\n        <td width=25%>NPD Date : {% if doc.npd_date %}{{ frappe.utils.formatdate(doc.npd_date) }}{% endif %}</td>\n    </tr>\n    <tr>\n        <td width=50%>Attention To : {{ doc.get(\"attention_to\") or \"\" }}</td>\n        <td width=25%>INQ No. : {{ doc.get(\"inquiry\") or \"\" }}</td>\n        <td width=25%>Quote No : {{ doc.get(\"quote_no\") or \"\" }}</td>\n    </tr>\n    <tr>\n        <td width=50%></td>\n        <td width=25%></td>\n        <td width=25%>Sales p. : {{ doc.get(\"sales_person\") or \"\" }}</td>\n    </tr>\n</table>\n\n<br>\nJob Title : {{ doc.get(\"job_title\") or \"\" }}<br>\nMaterial : {{ doc.get(\"material\") or \"\" }}<br>\nBOM Materials<br>\nReq. Sample Quantity : {{ doc.get(\"sample_qty\") or 0 }}<br>\nSize : {{ doc.get(\"size\") or \"\" }}<br>\nColor reference : {{ doc.get(\"color_ref\") or \"\" }}<br>\nColors : {{ doc.get(\"colors\") or 0 }}<br>\nFinishings : {{ doc.get(\"finishings\") or \"\" }}<br>\nRemarks : {{ doc.get(\"remarks\") or \"\" }}<br><br>\n\n<table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n    <tr>\n        <td style=\"width: 4%; border: 1px solid #000; text-align: center;\">#</td>\n        <td style=\"width: 10%; border: 1px solid #000; text-align: center;\">Size</td>\n        <td style=\"width: 30%; border: 1px solid #000; text-align: center;\">Description</td>\n        <td style=\"width: 8%; border: 1px solid #000; text-align: center;\">Quantity</td>\n        <td style=\"width: 12%; border: 1px solid #000; text-align: center;\">Full Sheet Size</td>\n        <td style=\"width: 14%; border: 1px solid #000; text-align: center;\">Cut Sheet Size</td>\n        <td style=\"width: 8%; border: 1px solid #000; text-align: center;\">Full Sheets</td>\n        <td style=\"width: 8%; border: 1px solid #000; text-align: center;\">Cut Sheets</td>\n        <td style=\"width: 3%; border: 1px solid #000; text-align: center;\">Ups</td>\n        <td style=\"width: 3%; border: 1px solid #000; text-align: center;\">Cuts</td>\n    </tr>\n    {% for r in d.lines %}\n    <tr>\n        <td style=\"border: 1px solid #000; text-align: center;\">{{ loop.index }}</td>\n        <td style=\"border: 1px solid #000; text-align: center;\">{{ r.size }}</td>\n        <td style=\"border: 1px solid #000;\">{{ r.item_name }}</td>\n        <td style=\"border: 1px solid #000; text-align: right;\">{{ frappe.format_value(r.qty, {\"fieldtype\": \"Float\"}) }}</td>\n        <td style=\"border: 1px solid #000; text-align: center;\">{{ r.full_sheet_size }}</td>\n        <td style=\"border: 1px solid #000; text-align: center;\">{{ r.cut_sheet_size }}</td>\n        <td style=\"border: 1px solid #000; text-align: right;\">{{ frappe.format_value(r.full_sheets, {\"fieldtype\": \"Float\"}) }}</td>\n        <td style=\"border: 1px solid #000; text-align: right;\">{{ frappe.format_value(r.cut_sheets, {\"fieldtype\": \"Float\"}) }}</td>\n        <td style=\"border: 1px solid #000; text-align: center;\">{{ r.ups }}</td>\n        <td style=\"border: 1px solid #000; text-align: center;\">{{ r.cuts }}</td>\n    </tr>\n    {% endfor %}\n</table>\n\n<br>\n{% if d.materials %}\n<div style=\"font-weight:bold;\">BOM Materials</div>\n<table style=\"width: 60%; border-collapse: collapse; table-layout: fixed;\">\n    <tr>\n        <td style=\"width: 70%; border: 1px solid #000; text-align: center;\">Item Name</td>\n        <td style=\"width: 15%; border: 1px solid #000; text-align: center;\">Unit</td>\n        <td style=\"width: 15%; border: 1px solid #000; text-align: center;\">Quantity</td>\n    </tr>\n    {% for m in d.materials %}\n    <tr>\n        <td style=\"border: 1px solid #000;\">{{ m.item_name or m.item }}</td>\n        <td style=\"border: 1px solid #000; text-align: center;\">{{ m.uom or \"\" }}</td>\n        <td style=\"border: 1px solid #000; text-align: right;\">{{ frappe.format_value(m.quantity, {\"fieldtype\": \"Float\"}) }}</td>\n    </tr>\n    {% endfor %}\n</table>\n{% endif %}\n\n<br>\n<table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n    <tr>\n        <td width=33%>Winding Direction : {{ doc.get(\"winding_direction\") or \"\" }}</td>\n        <td width=33%>No of inner pages : {{ doc.get(\"no_of_inner_pages\") or 0 }}</td>\n        <td width=34%></td>\n    </tr>\n    <tr>\n        <td width=33%>No of ups per reel : {{ doc.get(\"no_of_ups_per_reel\") or 0 }}</td>\n        <td width=33%>No of cover pages : {{ doc.get(\"no_of_cover_pages\") or 0 }}</td>\n        <td width=34%></td>\n    </tr>\n    <tr>\n        <td width=33%>No of labels per reel : {{ doc.get(\"no_of_labels_per_reel\") or 0 }}</td>\n        <td width=33%>Core size : {{ doc.get(\"core_size\") or 0 }}</td>\n        <td width=34%></td>\n    </tr>\n</table>\n\n<br><br>\n<table style=\"width: 60%; border-collapse: collapse; table-layout: fixed;\">\n    <tr>\n        <td style=\"width: 50%; text-align: center; border: none;\"><div style=\"border-bottom: 1px dotted #000; min-height: 16px;\">{{ created_by }}</div></td>\n        <td style=\"width: 50%; text-align: center; border: none;\"><div style=\"border-bottom: 1px dotted #000; min-height: 16px;\">{{ d.approved_by or \"Pending\" }}</div></td>\n    </tr>\n    <tr>\n        <td style=\"text-align: center; border: none;\">Created by<br>{% if d.created_on %}{{ frappe.utils.format_datetime(d.created_on, \"dd-MM-yyyy HH:mm:ss\") }}{% endif %}</td>\n        <td style=\"text-align: center; border: none;\">Approved by<br>{% if d.approved_on %}{{ frappe.utils.format_datetime(d.approved_on, \"dd-MM-yyyy HH:mm:ss\") }}{% endif %}</td>\n    </tr>\n</table>\n",
