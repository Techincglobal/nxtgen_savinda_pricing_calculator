{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-07-29 09:50:25.676311",
 "css": "",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Production Plan",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    .print-format td, .print-format th {\n        padding: 3px !important;\n    }\n    \n    .print-format {\n        margin-left: 5mm;\n        margin-right: 5mm;\n        font-family: Arial, sans-serif;\n    }\n    \n</style>\n\n<head>\n    <meta name=\"pdfkit-margin-top\" content=\"30mm\"/>\n    <meta name=\"pdfkit-orientation\" content=\"Landscape\"/>\n</head>\n\n{% set production_item = doc.po_items[0] if doc.po_items else none %}\n{% set sales_order_row = doc.sales_orders[0] if doc.sales_orders else none %}\n{% set sales_order_no = sales_order_row.sales_order if sales_order_row else \"\" %}\n{% set sales_order = frappe.get_doc(\"Sales Order\", sales_order_no) if (sales_order_no and frappe.db.exists(\"Sales Order\", sales_order_no)) else none %}\n{% set bom_no = production_item.bom_no if production_item and production_item.bom_no else \"\" %}\n{% set bom = frappe.get_doc(\"BOM\", bom_no) if (bom_no and frappe.db.exists(\"BOM\", bom_no)) else none %}\n{% set quotation_no = doc.get(\"custom_quote_no\") or \"\" %}\n{% set quotation = frappe.get_doc(\"Savinda Quotation\", quotation_no) if (quotation_no and frappe.db.exists(\"Savinda Quotation\", quotation_no)) else none %}\n{% set sales_person = sales_order.sales_team[0].sales_person if sales_order and sales_order.sales_team else \"\" %}\n{% set customer_name = sales_order.customer_name if sales_order and sales_order.customer_name else sales_order_row.customer if sales_order_row else \"\" %}\n{% set created_by = frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner %}\n{% set quoted_by = frappe.db.get_value(\"User\", quotation.owner, \"full_name\") if quotation else \"\" %}\n{% set bom_by = frappe.db.get_value(\"User\", bom.owner, \"full_name\") if bom else \"\" %}\n{% set downloaded_by = frappe.db.get_value(\"User\", frappe.session.user, \"full_name\") or frappe.session.user %}\n{% set d = get_ticket_print_data(doc.name) %}\n{% set h = d.header %}\n{% set customer_name = h.customer %}\n{% set sales_person = h.sales_person %}\n{% set quotation_no = h.quote_no %}\n\n<div id=\"header-html\">\n    <table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n        <tr>\n            <td width=30%>\n                Released at: {{ frappe.format_value(frappe.utils.now(), {\"fieldtype\": \"Date\"}) }} By {{ created_by }}\n            </td>\n            <td style=\"width: 40%; text-align: center;\">\n                Savinda Graphic Systems (Pvt) Ltd.\n            </td>\n            <td rowspan=2 width=30%>\n                <img src=\"https://barcodeapi.org/api/128/{{ doc.name }}\" alt=\"Barcode\" />\n            </td>\n        </tr>\n        <tr>\n            <td>\n                Printing Machine:\n            </td>\n            <td style=\"width: 40%; text-align: center;\">\n                Offset Job Ticket ( No FSC ) ( TIEP )  ( REPEAT ) \n            </td>\n        </tr>\n    </table>\n</div>\n\n<div id=\"footer-html\" class=\"visible-pdf\">\n    Page <span class=\"page\"></span> of <span class=\"topage\"></span>\n</div>\n\n<table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n    <tr>\n        <td colspan=3>\n            Job Title : {{ h.job_title }}\n        </td>\n        <td width=25%>\n        </td>\n    </tr>\n    <tr>\n        <td colspan=2>\n            Customer : {{ customer_name }}\n        </td>\n        <td width=25%>\n            Art No : {{ h.art_no }}\n        </td>\n        <td width=25%>\n            Job Date : \n            {% if doc.posting_date %}\n                {{ frappe.utils.formatdate(doc.posting_date) }}\n            {% endif %}\n        </td>\n    </tr>\n    <tr>\n        <td width=25%>\n            Job No : {{ doc.name }}\n        </td>\n        <td width=25%>\n            Ctn Size (L*W*H) : {{ h.ctn_size }}\n        </td>\n        <td width=25%>\n            SO No. : {{ h.so_no or sales_order_no }}\n        </td>\n        <td width=25%>\n            Req. Date : \n            {% if h.req_date %}\n                {{ frappe.utils.formatdate(h.req_date) }}\n            {% endif %}\n        </td>\n    </tr>\n    <tr>\n        <td width=25%>\n            PO No : {{ h.po_no }}\n        </td>\n        <td width=25%>\n            Colors : {{ h.colors }}\n        </td>\n        <td width=25%>\n            Quote No : {{ quotation_no }}\n        </td>\n        <td width=25%>\n            Sales Person : {{ sales_person }}\n        </td>\n    </tr>\n    <tr>\n        <td width=25%>\n            Job Board : {{ h.job_board }}\n        </td>\n        <td width=25%>\n            Color Ref. : {{ h.color_ref }}\n        </td>\n        <td width=25%>\n            Quantity :  \n            {{ frappe.format_value(h.quantity, {\"fieldtype\": \"Float\"}) }}\n        </td>\n        <td width=25%>\n            CS Person : {{ h.cs_person }}\n        </td>\n    </tr>\n</table>\n\n<table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n    <tr>\n        <td width=25%>\n            Reel Or Sheet : {{ h.reel_or_sheet }}\n        </td>\n        <td width=25%>\n            Pcs per Roll : {{ h.pcs_per_roll }}\n        </td>\n        <td width=25%>\n            Ups : {{ h.ups }}\n        </td>\n        <td width=25%>\n            Core Size : {{ h.core_size }}\n        </td>\n    </tr>\n    <tr>\n        <td width=25%>\n            Printed : \n        </td>\n        <td width=25%>\n            Win. Direction : {{ h.winding_direction }}\n        </td>\n        <td width=25%>\n        </td>\n        <td width=25%>\n        </td>\n    </tr>\n</table>\n\n<br>\n\nFinishings : {{ h.finishings }}<br>\nRemarks : {{ h.remarks }}<br><br>\n\n<table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n    <tr>\n        <td style=\"width: 24%; border: 1px solid #000; text-align: center;\">\n            Description\n        </td>\n        <td style=\"width: 6%; border: 1px solid #000; text-align: center;\">\n            Size\n        </td>\n        <td style=\"width: 6%; border: 1px solid #000; text-align: center;\">\n            Qty\n        </td>\n        <td style=\"width: 8%; border: 1px solid #000; text-align: center;\">\n            Pack Date\n        </td>\n        <td style=\"width: 8%; border: 1px solid #000; text-align: center;\">\n            Exp Date\n        </td>\n        <td style=\"width: 10%; border: 1px solid #000; text-align: center;\">\n            Batch/Lot No\n        </td>\n        <td style=\"width: 11%; border: 1px solid #000; text-align: center;\">\n            Product Code\n        </td>\n        <td style=\"width: 7%; border: 1px solid #000; text-align: center;\">\n            Full Sheets\n        </td>\n        <td style=\"width: 7%; border: 1px solid #000; text-align: center;\">\n            Cut Sheets\n        </td>\n        <td style=\"width: 7%; border: 1px solid #000; text-align: center;\">\n            F. Sheet Size\n        </td>\n        <td style=\"width: 6%; border: 1px solid #000; text-align: center;\">\n            C. Sheet Size\n        </td>\n        <td style=\"width: 3%; border: 1px solid #000; text-align: center;\">\n            Cuts\n        </td>\n        <td style=\"width: 3%; border: 1px solid #000; text-align: center;\">\n            Ups\n        </td>\n    </tr>\n\n        {% for item in d.lines %}\n        <tr>\n            <td style=\"border: 1px solid #000;\">{{ item.description }}</td>\n            <td style=\"border: 1px solid #000; text-align: center;\">{{ item.variant_value or item.size }}</td>\n            <td style=\"border: 1px solid #000; text-align: right;\">{{ frappe.format_value(item.qty, {\"fieldtype\": \"Float\"}) }}</td>\n            <td style=\"border: 1px solid #000; text-align: center;\">{% if item.pack_date %}{{ frappe.utils.formatdate(item.pack_date) }}{% endif %}</td>\n            <td style=\"border: 1px solid #000; text-align: center;\">{% if item.exp_date %}{{ frappe.utils.formatdate(item.exp_date) }}{% endif %}</td>\n            <td style=\"border: 1px solid #000;\">{{ item.batch_no }}</td>\n            <td style=\"border: 1px solid #000;\">{{ item.product_code }}</td>\n            <td style=\"border: 1px solid #000; text-align: right;\">{{ frappe.format_value(item.full_sheets, {\"fieldtype\": \"Float\"}) }}</td>\n            <td style=\"border: 1px solid #000; text-align: right;\">{{ frappe.format_value(item.cut_sheets, {\"fieldtype\": \"Float\"}) }}</td>\n            <td style=\"border: 1px solid #000; text-align: center;\">{{ item.full_sheet_size }}</td>\n            <td style=\"border: 1px solid #000; text-align: center;\">{{ item.cut_sheet_size }}</td>\n            <td style=\"border: 1px solid #000; text-align: center;\">{{ item.cuts }}</td>\n            <td style=\"border: 1px solid #000; text-align: center;\">{{ item.ups }}</td>\n        </tr>\n    {% endfor %}\n</table>\n\n<br>\n\n<table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n    <tr>\n        <!-- Batch number section -->\n        <td style=\"width: 50%; vertical-align: top; padding-right: 15px !important;\">\n\n            <table style=\"width: 100%; border-collapse: collapse;\">\n                <tr>\n                    <td style=\"width: 30%; border: none;\">\n                        Board/Paper (B/N)\n                    </td>\n                    <td style=\"width: 5%; border: none;\">\n                        :\n                    </td>\n                    <td style=\"width: 65%; border: none; border-bottom: 1px dotted #000;\">\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"border: none;\">\n                        Ink - (B/N)\n                    </td>\n                    <td style=\"border: none;\">\n                        :\n                    </td>\n                    <td style=\"border: none; border-bottom: 1px dotted #000;\">\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"border: none;\">\n                        Varnish (B/N)\n                    </td>\n                    <td style=\"border: none;\">\n                        :\n                    </td>\n                    <td style=\"border: none; border-bottom: 1px dotted #000;\">\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"border: none;\">\n                        Gum (B/N)\n                    </td>\n                    <td style=\"border: none;\">\n                        :\n                    </td>\n                    <td style=\"border: none; border-bottom: 1px dotted #000;\">\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"border: none;\">\n                        Extra (B/N)\n                    </td>\n                    <td style=\"border: none;\">\n                        :\n                    </td>\n                    <td style=\"border: none; border-bottom: 1px dotted #000;\">\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"border: none;\">\n                        Remarks\n                    </td>\n                    <td style=\"border: none;\">\n                        :\n                    </td>\n                    <td style=\"border: none; border-bottom: 1px dotted #000;\">\n                    </td>\n                </tr>\n            </table>\n        </td>\n\n        <!-- BOM Materials section -->\n        <td style=\"width: 50%; vertical-align: top;\">\n            <div style=\"text-align: center; font-weight: bold; margin-bottom: 4px;\">\n                BOM Materials (Non-Board Items)\n            </div>\n\n            <table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n                <tr>\n                    <td style=\"width: 72%; border: 1px solid #000; text-align: center;\">\n                        Item Name\n                    </td>\n                    <td style=\"width: 10%; border: 1px solid #000; text-align: center;\">\n                        Unit\n                    </td>\n                    <td style=\"width: 18%; border: 1px solid #000; text-align: center;\">\n                        Quantity\n                    </td>\n                </tr>\n\n                {% for material in d.materials %}\n                    <tr>\n                        <td style=\"border: 1px solid #000;\">\n                            {{ material.item_name or material.item_code }}\n                        </td>\n\n                        <td style=\"border: 1px solid #000; text-align: center;\">\n                            {{ material.uom or \"\" }}\n                        </td>\n\n                        <td style=\"border: 1px solid #000; text-align: right;\">\n                            {{ frappe.format_value(material.quantity,{\"fieldtype\": \"Float\"}) }}\n                        </td>\n                    </tr>\n                {% endfor %}\n            </table>\n        </td>\n    </tr>\n</table>\n\n<br>\n\n<table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n    <tr>\n        <td>\n            <table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n                <tr>\n                    <td style=\"width: 25%; border: 1px solid #000;\">\n                        <strong>CUTTER :</strong>\n                        {{ doc.get(\"custom_cutter\") or \"\" }}\n                    </td>\n            \n                    <td style=\"width: 25%; border: 1px solid #000;\">\n                        <strong>EMBOSS :</strong>\n                        {{ doc.get(\"custom_emboss\") or \"\" }}\n                    </td>\n            \n                    <td style=\"width: 25%; border: 1px solid #000;\">\n                        <strong>FOIL :</strong>\n                        {{ doc.get(\"custom_foil\") or \"\" }}\n                    </td>\n            \n                    <td style=\"width: 25%; border: 1px solid #000;\">\n                        <strong>POSITIVE :</strong>\n                        {{ doc.get(\"custom_positive\") or \"\" }}\n                    </td>\n                </tr>\n            </table>\n            \n            <br>\n            <br>\n            \n            <table style=\"width: 100%; border-collapse: collapse; table-layout: fixed;\">\n                                <tr>\n                    <td style=\"width: 20%; text-align: center; border: none;\">\n                        <div style=\"border-bottom: 1px dotted #000; min-height: 16px;\">{{ d.approvals[0].by or created_by }}</div>\n                    </td>\n                    <td style=\"width: 20%; text-align: center; border: none;\">\n                        <div style=\"border-bottom: 1px dotted #000; min-height: 16px;\">{{ d.approvals[1].by }}</div>\n                    </td>\n                    <td style=\"width: 20%; text-align: center; border: none;\">\n                        <div style=\"border-bottom: 1px dotted #000; min-height: 16px;\">{{ d.approvals[2].by }}</div>\n                    </td>\n                    <td style=\"width: 20%; text-align: center; border: none;\">\n                        <div style=\"border-bottom: 1px dotted #000; min-height: 16px;\">{{ d.approvals[3].by or quoted_by }}</div>\n                    </td>\n                    <td style=\"width: 20%; text-align: center; border: none;\">\n                        <div style=\"border-bottom: 1px dotted #000; min-height: 16px;\">{{ d.approvals[4].by or bom_by }}</div>\n                    </td>\n                </tr>\n            \n                <tr>\n                    <td style=\"text-align: center; border: none;\">\n                        Created by\n                    </td>\n            \n                    <td style=\"text-align: center; border: none;\">\n                        Artwork approved by\n                    </td>\n            \n                    <td style=\"text-align: center; border: none;\">\n                        Checked by - Supply Chain\n                    </td>\n            \n                    <td style=\"text-align: center; border: none;\">\n                        Quoted by\n                    </td>\n            \n                    <td style=\"text-align: center; border: none;\">\n                        BOM By\n                    </td>\n                </tr>\n            \n                <tr>\n                    <td style=\"text-align: center; border: none;\">\n                        {{ frappe.utils.format_datetime(doc.creation,\"dd-MM-yyyy HH:mm:ss\") }}\n                    </td>\n            \n                    <td style=\"text-align: center; border: none;\">\n                        {% if doc.get(\"custom_artwork_approved_on\") %}\n                            {{ frappe.utils.format_datetime(doc.get(\"custom_artwork_approved_on\"),\"dd-MM-yyyy HH:mm:ss\") }}\n                        {% endif %}\n                    </td>\n            \n                    <td style=\"text-align: center; border: none;\">\n                        {% if doc.get(\"custom_supply_chain_checked_on\") %}\n                            {{ frappe.utils.format_datetime(doc.get(\"custom_supply_chain_checked_on\"),\"dd-MM-yyyy HH:mm:ss\") }}\n                        {% endif %}\n                    </td>\n            \n                    <td style=\"text-align: center; border: none;\">\n                        {% if quotation %}\n                            {{ frappe.utils.format_datetime(quotation.creation,\"dd-MM-yyyy HH:mm:ss\") }}\n                        {% endif %}\n                    </td>\n            \n                    <td style=\"text-align: center; border: none;\">\n                        {% if bom %}\n                            {{ frappe.utils.format_datetime(bom.creation,\"dd-MM-yyyy HH:mm:ss\") }}\n                        {% endif %}\n                    </td>\n                </tr>\n            </table>\n        </td>\n    </tr>\n</table>\n",
